# Guardar sin BOM UTF-8 (no usar PowerShell Set-Content). Nunca en Git con valores reales.

# --- Tests ---
# Base de TEST (su nombre debe terminar en _test: los tests borran y recrean sus tablas).
VSCAR_TEST_DATABASE_URL=mysql://vscar_test:CHANGE_ME@127.0.0.1:3306/vscar_test
# Test en vivo contra la API EEA (opcional; CI no lo usa)
# VSCAR_EEA_LIVE=1
# VSCAR_MITECO_LIVE=1
# VSCAR_ESIOS_LIVE=1

# --- VScarWorker (en el VPS: C:\vscar\config\worker.env) ---
DATABASE_URL=mysql://vscar_app:CHANGE_ME@127.0.0.1:3306/vscar_db
VSCAR_DATA_DIR=C:\vscar\data
VSCAR_LOG_DIR=C:\vscar\logs
WORKER_POLL_MS=10000
WORKER_ID=vps-worker-1
WORKER_STALE_LOCK_MIN=30
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=8180
EEA_BASE_URL=https://discodata.eea.europa.eu/sql
EEA_TIMEOUT_MS=60000
MITECO_BASE_URL=https://sedeaplicaciones.minetur.gob.es/ServiciosRESTCarburantes/PreciosCarburantes
MITECO_TIMEOUT_MS=180000
ESIOS_BASE_URL=https://api.esios.ree.es
ESIOS_TIMEOUT_MS=60000
# Token personal de ESIOS (opcional en v0.1: el archivo PVPC es público). Secreto: nunca en Git ni en logs.
ESIOS_TOKEN=
