    "@vscar/economics-engine": "workspace:*",
    "@vscar/market-context": "workspace:*",
    "@vscar/methodology": "workspace:*",
    "@vscar/ui": "workspace:*",
    "@vscar/vehicle-schema": "workspace:*",
    "geist": "1.7.2",
    "gsap": "3.15.0",
    "motion": "13.5.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "server-only": "0.0.1",
    "zod": "^3.25.67",
